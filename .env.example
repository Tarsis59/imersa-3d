# Dono do banco: só para migrations
DATABASE_URL_OWNER=postgres://imersa_owner:imersa_owner_dev@localhost:55432/imersa
# Papel da aplicação: SEM superusuário e SEM bypass de RLS
DATABASE_URL=postgres://imersa_app:imersa_app_dev@localhost:55432/imersa
# Gere cada segredo com: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=troque-este-segredo-por-um-aleatorio-de-48-bytes
# 32 bytes exatos: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
TOTP_KEY=
PORT=3333
CORS_ORIGIN=http://localhost:3000
WEB_URL=http://localhost:3000
RATE_LIMIT_AUTH=10
TRUST_PROXY=false
SENTRY_DSN=
AMBIENTE=dev
# Usado pelo site (apps/web)
API_URL=http://localhost:3333
# endereço público do site (prévia do link no WhatsApp); na Vercel vem sozinho do domínio de produção
SITE_URL=http://localhost:3000
